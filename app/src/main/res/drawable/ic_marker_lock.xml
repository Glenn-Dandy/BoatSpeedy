    android:width="48dp" android:height="48dp"
    android:viewportWidth="44" android:viewportHeight="44">
    <group android:translateX="10" android:translateY="10">
    <path android:fillColor="#FFFFFF" android:pathData="M12,1 A11,11 0 1,1 11.99,1 Z" />
    <path android:fillColor="#1565C0" android:pathData="M12,3 A9,9 0 1,1 11.99,3 Z" />
